{
  "manifest_version": 3,
  "name": "Dhriti Wall",
  "version": "0.7.0",
  "description": "Local commitment enforcement. The wall does not respond. Your own contract is the only voice. Requires the Dhriti daemon.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*",
    "*://*.google.com/*",
    "*://*.google.co.in/*",
    "*://*.gstatic.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dhriti Dashboard"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://x.com/*",
        "*://twitter.com/*",
        "*://www.google.com/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": ["suppress.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://chat.deepseek.com/*",
        "*://claude.ai/*"
      ],
      "js": ["chatguard_content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.gstatic.com/*"
      ],
      "js": ["images-wall.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {}
}
