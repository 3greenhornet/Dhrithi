# ==============================================================================
# Dhriti .gitignore — Secrets, Personal Data, Caches, & Runtime Artifacts
# ==============================================================================

# Personal & Runtime Experiment Data (Never Commit Personal Records)
*.sqlite3*
*.sqlite
*.db
guard_content.sqlite3*
bridge_token*
*.token
*cookie*.txt
watch_later.json
liked_videos.json
bookmarks_corpus.json
*playlist*.json
brave_cookies_temp*
daemon.lock
hosts/
extension_last_seen
reports/
profiles/ignite.*.json
*.log

# Environment variables & Secrets
.env
.env.*
!.env.example

# Local models and vector cache
.cache/
models/
*.onnx

# Python bytecode, builds, and test caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Virtual Environments
venv/
.venv/
env/

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Codebase snapshots & dumps
*repomix*
dhrithi-repomix.md

# Demo output is regenerated, not tracked
examples/demo/out/
