# ==============================================================================
# Dhriti Environment Configuration Template
# Copy this file to .env or set environment variables in your shell.
# ==============================================================================

# Custom Dhriti home directory (defaults to ~/.dhriti if unset)
DHRITI_HOME=

# Core daemon loopback bridge port (default: 7311)
DHRITI_PORT=7311

# AI Classifier Sidecar port (default: 8765)
DHRITI_SIDECAR_PORT=8765

# Local bridge authorization token.
# Generated automatically on `dhriti init` at ~/.dhriti/bridge_token.
# Set here if overriding or in headless automation environments.
DHRITI_TOKEN=

# Embedding model backend (options: fastembed, sentence-transformers, deterministic)
DHRITI_EMBEDDING_BACKEND=fastembed

# FastEmbed ONNX model identifier (default: BAAI/bge-small-en-v1.5)
DHRITI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Log verbosity (DEBUG, INFO, WARNING, ERROR)
DHRITI_LOG_LEVEL=INFO

